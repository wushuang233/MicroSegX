ARG BASE_PREFIX
ARG BASE_IMAGE_TAG
FROM microsegx/${BASE_PREFIX}controller_base:${BASE_IMAGE_TAG}

COPY stage /

ARG NV_TAG
LABEL name="controller" \
      vendor="MicroSegX Inc." \
      version=${NV_TAG} \
      release=${NV_TAG} \
      microsegx.image="microsegx/controller" \
      microsegx.role="controller" \
      microsegx.rev="git.xxxx"


ENTRYPOINT ["/usr/local/bin/monitor", "-c"]
