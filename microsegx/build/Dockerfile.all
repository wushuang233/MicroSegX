ARG BASE_PREFIX
ARG BASE_IMAGE_TAG
FROM microsegx/${BASE_PREFIX}all_base:${BASE_IMAGE_TAG}

COPY stage /

ARG NV_TAG
LABEL name="allinone" \
      vendor="MicroSegX Inc." \
      version=${NV_TAG} \
      release=${NV_TAG} \
      microsegx.image="microsegx/allinone" \
      microsegx.role="controller+enforcer+manager"

ENTRYPOINT ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
