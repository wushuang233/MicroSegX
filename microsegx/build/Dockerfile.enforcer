ARG BASE_PREFIX
ARG BASE_IMAGE_TAG
FROM microsegx/${BASE_PREFIX}enforcer_base:${BASE_IMAGE_TAG}

COPY stage /

# Labels for redhat
ARG NV_TAG
LABEL name="enforcer" \
      vendor="MicroSegX Inc." \
      version=${NV_TAG} \
      release=${NV_TAG} \
      microsegx.image="microsegx/enforcer" \
      microsegx.role="enforcer" \
      microsegx.rev="git.xxxx"

ENTRYPOINT ["/usr/local/bin/monitor", "-r"]
