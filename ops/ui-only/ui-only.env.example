# Copy this file to a private env file and adjust the values before use.

RELEASE_NAME=microsegx
NAMESPACE=microsegx

# registry | local-import | export-only
DEPLOY_MODE=registry

# Your source release images. These are used to copy controller/enforcer/scanner/updater
# when you are only rebuilding manager for UI work.
SOURCE_REGISTRY=docker.io
SOURCE_REPO_PREFIX=microsegx
SOURCE_TAG=5.5.0
SOURCE_SCANNER_TAG=6
SOURCE_UPDATER_TAG=0.0.9

# Your target images. TARGET_REGISTRY should not include http:// or https://.
TARGET_REGISTRY=registry.example.com
TARGET_REPO_PREFIX=nv
TARGET_TAG=5.5.0-ui.1

# Keep this pointing to your cluster-specific base values file if you already have one.
BASE_VALUES_FILE=
IMAGE_PULL_SECRET=regsecret

# containerd | crio | docker
CONTAINER_RUNTIME=containerd
RUNTIME_PATH=

# kind | k3d | minikube
CLUSTER_TYPE=kind
KIND_CLUSTER_NAME=kind
K3D_CLUSTER_NAME=k3s-default
MINIKUBE_PROFILE=minikube

# Optional: set to true if the target controller/enforcer/scanner/updater images
# already exist and only manager needs to be built locally.
SKIP_SYNC_CORE_IMAGES=false

# Optional: override the export directory for image tar archives.
EXPORT_DIR=
