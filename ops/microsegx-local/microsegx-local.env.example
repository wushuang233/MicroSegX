# Point this to the env file you already use for ops/full-release/*
FULL_RELEASE_ENV=/home/your-user/MicroSegX/ops/full-release/full-release.env

# Manager will proxy Port Exposure and Ziti to this in-cluster service.
MICROSEGX_PORT_AUDIT_BASE_URL=http://k8s-port-audit.port-audit.svc.cluster.local:8080

# How to import the k8s-port-audit-stack image locally.
# Supported: containerd, nerdctl, docker; k3s is legacy only
STACK_LOCAL_RUNTIME=containerd
STACK_CONTAINERD_NAMESPACE=k8s.io
