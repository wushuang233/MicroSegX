# Copy this file to openziti.k8s.env before running install-openziti-k8s.sh.
#
# You must fill:
#   ZITI_PUBLIC_HOST=<external IP or DNS name reachable by clients>
#   ZITI_STORAGE_CLASS_NAME=<your k8s StorageClass for ziti-controller-db>
#
# Optional:
#   ZITI_CONTROLLER_NODEPORT=<default 31280>
#   ZITI_ROUTER_NODEPORT=<default 30222>

ZITI_NAMESPACE=openziti
CERT_MANAGER_NAMESPACE=cert-manager

ZITI_CONTROLLER_RELEASE=ziti-controller
ZITI_ROUTER_RELEASE=ziti-router
ZITI_ROUTER_NAME=ziti-router
ZITI_ROUTER_ROLE=public-router

CERT_MANAGER_CHART_VERSION=1.20.1
TRUST_MANAGER_CHART_VERSION=0.22.0
ZITI_CONTROLLER_CHART_VERSION=3.1.1
ZITI_ROUTER_CHART_VERSION=2.1.0

ZITI_PUBLIC_HOST=__FILL_ME_PUBLIC_HOST__
ZITI_STORAGE_CLASS_NAME=__FILL_ME_STORAGE_CLASS__
ZITI_CONTROLLER_NODEPORT=31280
ZITI_ROUTER_NODEPORT=30222

ZITI_CONTROLLER_DB_PVC=ziti-controller-db
ZITI_CONTROLLER_DB_SIZE=2Gi
ZITI_ROUTER_ENROLLMENT_SECRET=ziti-router-enrollment
