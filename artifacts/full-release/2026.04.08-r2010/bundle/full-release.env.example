# Copy this file to full-release.env and adjust the values before running the scripts.

RELEASE_NAME=microsegx
NAMESPACE=microsegx

# Deployment mode:
#   registry = push images to a private registry, then pull from the cluster
#   local    = import images directly into the cluster node runtime
DEPLOY_MODE=registry

# Final image location in your private registry.
REGISTRY=harbor.example.com
IMAGE_NAMESPACE=nv

# Local mode image prefix. This is only an image name prefix, not a real registry service.
LOCAL_IMAGE_REGISTRY=local.microsegx
# Supported local runtimes: k3s, containerd, nerdctl, docker
LOCAL_RUNTIME=k3s
CONTAINERD_NAMESPACE=k8s.io

# Tags used by the release.
CORE_TAG=2026.04.05-r1
SCANNER_TAG=2026.04.05-scanner-r1
UPDATER_TAG=0.0.9
REGISTRY_ADAPTER_TAG=0.2.4
COMPLIANCE_CONFIG_TAG=1.0.11

# Build settings.
TARGET_PLATFORM=linux/amd64
ARTIFACT_DIR=
USE_LOCAL_DOCKERFILES=true
BUILD_FROM_SOURCE=true

# Optional registry authentication.
IMAGE_PULL_SECRET=
REGISTRY_USERNAME=
REGISTRY_PASSWORD=
REGISTRY_EMAIL=

# Access address for the manager UI.
MANAGER_HOST=nv.example.com
INGRESS_CLASS=nginx
MANAGER_TLS=false
MANAGER_TLS_SECRET=
MANAGER_SERVICE_TYPE=ClusterIP
MANAGER_NODE_PORT=

# Cluster sizing.
CONTROLLER_REPLICAS=1
SCANNER_REPLICAS=1

# Controller persistence.
# If left empty, deploy-core.sh applies safe defaults:
#   - local single-node k3s: enabled=true, accessMode=ReadWriteOnce,
#     storageClass=local-path, strategy=Recreate
#   - other environments: enabled=false
CONTROLLER_PVC_ENABLED=
CONTROLLER_PVC_EXISTING_CLAIM=
CONTROLLER_PVC_ACCESS_MODE=
CONTROLLER_PVC_STORAGE_CLASS=
CONTROLLER_PVC_CAPACITY=2Gi
CONTROLLER_STRATEGY_TYPE=

# Optional runtime override for non-default container runtime socket.
RUNTIME_PATH=

# Certificates and bootstrap.
AUTO_GENERATE_CERT=true
INTERNAL_AUTO_ROTATE_CERT=true
BOOTSTRAP_PASSWORD=

# Optional components.
BUILD_UPDATER_FROM_SOURCE=true
MIRROR_UPDATER=true
MIRROR_REGISTRY_ADAPTER=false
MIRROR_COMPLIANCE_CONFIG=false
ENABLE_REGISTRY_ADAPTER=false
ENABLE_CONTROLLER_PRIME=false
K3S_IMPORT_HELPER_NODE_NAME=
K3S_IMPORT_HELPER_NODE_IP=

# Upstream image sources for the optional mirrored images.
UPSTREAM_UPDATER_IMAGE=microsegx/updater:0.0.9
UPSTREAM_REGISTRY_ADAPTER_IMAGE=microsegx/registry-adapter:0.2.4
UPSTREAM_COMPLIANCE_CONFIG_IMAGE=microsegx/compliance-config:1.0.11

# Optional explicit kubeconfig on the deployment server.
KUBECONFIG=
