RELEASE_NAME=microsegx
NAMESPACE=microsegx

DEPLOY_MODE=local
IMAGE_NAMESPACE=microsegx
LOCAL_IMAGE_REGISTRY=local.microsegx
LOCAL_RUNTIME=k3s
CONTAINERD_NAMESPACE=k8s.io

CORE_TAG=2026.04.08-r2010
SCANNER_TAG=2026.04.08-scanner-r2010
UPDATER_TAG=2026.04.08-updater-r2010
REGISTRY_ADAPTER_TAG=0.2.4
COMPLIANCE_CONFIG_TAG=1.0.11

TARGET_PLATFORM=linux/amd64
ARTIFACT_DIR=/home/wushuang/MicroSegX/artifacts/full-release/2026.04.08-r2010

IMAGE_PULL_SECRET=
REGISTRY_USERNAME=
REGISTRY_PASSWORD=
REGISTRY_EMAIL=

MANAGER_HOST=
INGRESS_CLASS=nginx
MANAGER_TLS=false
MANAGER_TLS_SECRET=
MANAGER_SERVICE_TYPE=ClusterIP
MANAGER_NODE_PORT=

CONTROLLER_REPLICAS=1
SCANNER_REPLICAS=3
CONTROLLER_PVC_ENABLED=true
CONTROLLER_PVC_ACCESS_MODE=ReadWriteOnce
CONTROLLER_PVC_STORAGE_CLASS=local-path
CONTROLLER_PVC_CAPACITY=2Gi
CONTROLLER_STRATEGY_TYPE=Recreate

RUNTIME_PATH=/run/k3s/containerd/containerd.sock

AUTO_GENERATE_CERT=true
INTERNAL_AUTO_ROTATE_CERT=true
BOOTSTRAP_PASSWORD='MicroSegX@2026#Reset'

BUILD_UPDATER_FROM_SOURCE=true
MIRROR_UPDATER=true
MIRROR_REGISTRY_ADAPTER=false
MIRROR_COMPLIANCE_CONFIG=false
ENABLE_REGISTRY_ADAPTER=false
ENABLE_CONTROLLER_PRIME=false

UPSTREAM_UPDATER_IMAGE=microsegx/updater:0.0.9
UPSTREAM_REGISTRY_ADAPTER_IMAGE=microsegx/registry-adapter:0.2.4
UPSTREAM_COMPLIANCE_CONFIG_IMAGE=microsegx/compliance-config:1.0.11

KUBECONFIG=
