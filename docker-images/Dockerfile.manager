FROM ubuntu:24.04

ENV HTTP_PROXY= \
    HTTPS_PROXY= \
    ALL_PROXY= \
    http_proxy= \
    https_proxy= \
    all_proxy= \
    no_proxy= \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    gawk \
    grep \
    iproute2 \
    lsof \
    openjdk-17-jre-headless \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

COPY manager/package/requirements.txt /tmp/requirements.txt
RUN python3 -m pip install --break-system-packages --no-cache-dir -r /tmp/requirements.txt \
    && rm -f /tmp/requirements.txt

RUN mkdir -p /usr/local/bin \
    /usr/lib64/jvm \
    /usr/lib64/jvm/java-17-openjdk-17/conf/security

COPY manager/admin/target/scala-3.3.5/admin-assembly-1.0.jar /usr/local/bin/admin-assembly-1.0.jar
COPY manager/cli/cli /usr/local/bin/
COPY manager/cli/cli.py /usr/local/bin/
COPY manager/cli/prog /usr/local/bin/prog
COPY manager/scripts /usr/local/bin/scripts
COPY manager/package/entrypoint.sh /entrypoint.sh
COPY manager/java.security /usr/lib64/jvm/java-17-openjdk-17/conf/security/java.security.fips

RUN chmod +x /entrypoint.sh /usr/local/bin/cli /usr/local/bin/cli.py /usr/local/bin/scripts/support /usr/local/bin/scripts/support.py \
    && cp /usr/lib/jvm/java-17-openjdk-amd64/conf/security/java.security /usr/lib64/jvm/java-17-openjdk-17/conf/security/java.security.default

ARG VERSION=dev
ARG COMMIT=local

LABEL name="manager" \
      vendor="MicroSegX" \
      version=${VERSION} \
      microsegx.image="microsegx/manager" \
      microsegx.role="manager"

ENTRYPOINT ["/bin/bash", "/entrypoint.sh"]
